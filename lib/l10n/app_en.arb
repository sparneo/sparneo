  "chartRealPeriodGainHelpTitle": "Gain over the period",
  "@chartRealPeriodGainHelpTitle": {
    "description": "Title of the help popup explaining the real-evolution period gain percentage (Modified Dietz), opened via the info icon on the total value card"
  },

  "chartRealPeriodGainHelpBody": "Gain over the period, excluding deposits and withdrawals: your market performance alone.\n\nThe percentage relates this gain to the average capital actually at work during the period: a recent deposit only counts for the time it was invested.\n\nThis percentage differs from the \"total gains\" one shown at the top of the screen, which relates its own gain to your current capital (cash included) — two different denominators, not a bug.",
  "@chartRealPeriodGainHelpBody": {
    "description": "Help popup body explaining the real-evolution period gain percentage (Modified Dietz) when no annualised figure is shown, i.e. periodGainPercentAnnualized is null — appends a cross-reference to the total-gain percentage's different denominator (closes the explanatory loop between the two help popups)"
  },

  "chartRealPeriodGainHelpBodyAnnualized": "Gain over the period, excluding deposits and withdrawals: your market performance alone.\n\nTwo percentages are shown: the first is the cumulative gain over the whole period, the second (in brackets) the average yearly return — comparable to an index.\n\nBoth relate the gain to the average capital actually at work: a recent deposit only counts for the time it was invested.\n\nThis percentage differs from the \"total gains\" one shown at the top of the screen, which relates its own gain to your current capital (cash included) — two different denominators, not a bug.",
  "@chartRealPeriodGainHelpBodyAnnualized": {
    "description": "Help popup body explaining the real-evolution period gain percentage (Modified Dietz) when a second, annualised percentage is also shown, i.e. periodGainPercentAnnualized is non-null — appends the same cross-reference paragraph as chartRealPeriodGainHelpBody"
  },

  "chartRealTotalGainHelpTitle": "Total gains",
  "@chartRealTotalGainHelpTitle": {
    "description": "Title of the help popup explaining the 'Total gains' line, opened via the info icon shown below the chart in real-evolution mode"
  },

  "chartRealTotalGainHelpBody": "Total gains since inception: current value minus invested capital (your cash deposits and transferred-in securities, counted at their cost basis).\n\nThis amount matches, by construction, the gap between the two curves on the chart. Any residual gap only comes from the price source: real-time quote for this card, last known historical point for the curve.\n\nThe percentage above relates this gain to your CURRENT capital (cash included); the one shown below the chart relates it to the AVERAGE capital actually at work over the period (Modified Dietz) — two different denominators for the same gain, not a bug.",
  "@chartRealTotalGainHelpBody": {
    "description": "Help popup body explaining the 'Total gains' line (chartRealTotalGain/chartRealTotalGainAmountOnly) shown below the chart in real-evolution mode — corrected 29/07 UI cleanup: the 'Invested capital' curve now uses the declared cost basis, so the gap between the two curves equals the total gain by construction (previously falsely stated it valued transferred-in securities at entry-day price); also cross-references the period-gain percentage's different denominator"
  },

  "chartRealTotalGainFeesLine": "Of which fees (custody, account maintenance…): {amount}",
  "@chartRealTotalGainFeesLine": {
    "description": "Extra line appended to the 'Total gains' help popup body when RealTotalGain.chargesTotal is non-zero, isolating the charge-only sub-total that is otherwise buried in the aggregated 'revenus' term (dividend+interest+charge) — amount is an already-formatted signed money string, negative in the common case (fees), positive for a rebate",
    "placeholders": {
      "amount": {
        "type": "String",
        "example": "-45,00 €"
      }
    }
  },

