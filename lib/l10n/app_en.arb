  "chartModePerformanceCaption": "Today's quantities applied to past prices — not your real buys/sells.",
  "@chartModePerformanceCaption": {
    "description": "Short, always-visible caption shown below the chart in performance mode (mode 1) — keeps only the clause that discriminates it from real-evolution mode; the full method explanation moved to chartModeHelpBody"
  },

  "chartModeRealEvolution": "Real evolution",
  "@chartModeRealEvolution": {
    "description": "Chart mode selector segment: mode 2, net worth reconstructed from the journaled transaction history"
  },

  "chartModeHelpTitle": "Display modes",
  "@chartModeHelpTitle": {
    "description": "Title of the help popup explaining both chart modes at once, opened via the info icon next to the mode selector (SegmentedButton)"
  },

  "chartModeHelpBody": "\"Real evolution\": reconstructed from your journaled transactions (buys, sells, deposits, withdrawals) — the actual course of your wealth over time.\n\n\"Your holdings\": value your current holdings would have had at past prices (today's quantities assumed constant) — doesn't reflect your real buys and sells.",
  "chartModeHelpPositionBody": "\"Real evolution\": reconstructed from your transactions on this line (buys, sells) — what you actually held at each date, so a recent top-up shows as a step rather than being spread over the whole window.\n\n\"Your holdings\": value your CURRENT quantity would have had at past prices — useful to judge the security itself, but it doesn't reflect your own buys and sells.",
  "@chartModeHelpPositionBody": {
    "description": "Position-detail variant of chartModeHelpBody. Same two modes, but worded for a single line rather than a whole portfolio: the retro-projection's specific lie here is back-projecting today's quantity, which a wallet-level wording doesn't convey. ORDER MATTERS, same as chartModeHelpBody."
  },

  "@chartModeHelpBody": {
    "description": "Body of the help popup explaining both chart modes at once (merges the former chartModePerformanceCaption method explanation and chartModeRealCaption's journal-reconstruction sentence). ORDER MATTERS: \"Real evolution\" comes FIRST, matching both the mode selector order and the default mode since the UI decluttering pass — the popup used to open on the non-default mode, which read as if it were the main one."
  },

  "chartRealExcludedLegacyCaption": "{count, plural, =1{One position entered without history isn't included in this curve.} other{{count} positions entered without history aren't included in this curve.}}",
  "@chartRealExcludedLegacyCaption": {
    "description": "Caption shown below the chart in real-evolution mode, ONLY when count > 0 — replaces the former unconditional chartModeRealCaption sentence about legacy positions; a cash account has count == 0 by construction (no positions) so never shows this caption",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },

  "chartApproxValuesWarning": "Price unavailable for {count} security(ies): value held at last known price (flat curve over those periods).",
  "@chartApproxValuesWarning": {
    "description": "Warning shown in real-evolution mode when some symbols fall back to their last known price",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },

  "chartRealCoverageFallbackCaption": "The real-evolution curve only covers about {percent}% of your current value, so it is shown second.",
  "@chartRealCoverageFallbackCaption": {
    "description": "Caption shown below the chart in performance mode (mode 1) ONLY when the mode policy fell back to it on its own: no explicit user choice for this scope AND the real curve covers less than the coverage threshold of the current valuation. Explains the demotion, and nothing else: what is missing, and what to do about it, is named by chartRealExcludedLegacyNamedPrefix rendered just above — repeating the advice here would be two notes saying the same thing.",
    "placeholders": {
      "percent": {
        "type": "int",
        "example": "43"
      }
    }
  },

  "chartRealCoverageWarning": "This curve only covers about {percent}% of your current value: positions with no history, or securities with no usable price, are missing from it.",
  "@chartRealCoverageWarning": {
    "description": "Warning shown below the chart in real-evolution mode (mode 2) when the reconstructed curve covers less than the coverage threshold of the current valuation — same visual treatment as chartApproxValuesWarning. Says nothing about the default mode: the user is looking at the real curve either way. Names only the REAL causes: untracked cash is absent from BOTH sides of the ratio and never lowers coverage.",
    "placeholders": {
      "percent": {
        "type": "int",
        "example": "43"
      }
    }
  },

  "chartRealCoverageWarningShort": "In all, this curve only covers about {percent}% of your current value.",
  "@chartRealCoverageWarningShort": {
    "description": "Variant of chartRealCoverageWarning used when a note ABOVE it has already named what is missing (the named legacy-positions list, or the approximate-values warning). Same number, no cause: naming the cause twice in two consecutive lines is the redundancy this variant exists to remove.",
    "placeholders": {
      "percent": {
        "type": "int",
        "example": "43"
      }
    }
  },

  "chartRealExcludedLegacyNamedPrefix": "{count, plural, =1{One position with no history is missing from this curve:} other{{count} positions with no history are missing from this curve:}}",
  "@chartRealExcludedLegacyNamedPrefix": {
    "description": "Opening clause of the NAMED variant of the excluded-legacy note: the count, followed by a colon and the clickable names themselves (account names on the wallet screen, symbols on the account screen). Replaces chartRealExcludedLegacyCaption wherever names are available — a bare count told the user nothing about which positions, nor where to act.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },

  "chartRealExcludedLegacyNoCurvePrefix": "{count, plural, =1{No real evolution to reconstruct: one position with no history:} other{No real evolution to reconstruct: {count} positions with no history:}}",
  "@chartRealExcludedLegacyNoCurvePrefix": {
    "description": "Opening clause of the named excluded-legacy note used INSTEAD of chartRealExcludedLegacyNamedPrefix when there is no real-evolution curve at all (not merely one that omits these positions) — e.g. an account or a whole wallet where every position is legacy (no journaled movement anywhere). chartRealExcludedLegacyNamedPrefix's \"is missing from this curve\" is false in that case: there is no curve to be missing from. Same named/clickable list follows either way, cf. ChartNotes.realCurveAvailable.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },

  "chartRealExcludedLegacyOtherModePrefix": "{count, plural, =1{One position with no history is missing from the real evolution:} other{{count} positions with no history are missing from the real evolution:}}",
  "@chartRealExcludedLegacyOtherModePrefix": {
    "description": "Opening clause of the named excluded-legacy note used INSTEAD of chartRealExcludedLegacyNamedPrefix when mode 1 (\"Your positions\") is the one on screen while a real-evolution curve DOES exist (realCurveAvailable true, useRealCurve false — automatic fallback or an explicit user choice). chartRealExcludedLegacyNamedPrefix's \"is missing from this curve\" can only mean the curve on screen, and mode 1's curve INCLUDES these positions — the real evolution is the only curve they are actually missing from, so it must be named explicitly rather than pointed at with \"this\".",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },

