  "cryptoTransferOutApproxEur": "(≈ {eur})",
  "@cryptoTransferOutApproxEur": {
    "description": "Author request, B16 drive 09/15 ('see the cash equivalent of a withdrawal' / 'see the cash equivalent of an in-kind deposit'): appended after the raw quantity on an in-kind crypto withdrawal's or in-kind deposit's journal tile (account_journal_page.dart), only when an informative EUR equivalent could be computed — withdrawal: meta['valueEur'], best-effort, see AccountController._enrichCryptoWithdrawalsWithEurValuation; deposit: quantity × unitPrice (converted via meta['fxRate'] when the cost is in USD), see _inKindDepositEurApprox. Absent when unavailable (FX unreachable, no readable USD leg, or unsupported cost currency) — the raw quantity (or qty × price) is then shown, never blocking. The placeholder is an already-formatted currency string (Formatters.formatEur), not a raw number. Below 0.005 EUR the amount is instead shown via cryptoAmountBelowOneCent, never as a misleading '(≈ €0.00)'.",
    "placeholders": {
      "eur": { "type": "String" }
    }
  },

  "cryptoAmountBelowOneCent": "(< €0.01)",
  "@cryptoAmountBelowOneCent": {
    "description": "Author request, B16 drive 09/15: replaces '(≈ €0.00)' on an in-kind crypto withdrawal/deposit journal tile (account_journal_page.dart) when the computed EUR equivalent is strictly positive but rounds to zero at 2 decimals (dust — delisting/migration residues, real values around 1e-7 EUR). '(≈ €0.00)' reads as a missing value; this makes the near-zero-but-real amount explicit. Used only when the amount is strictly positive and below 0.005 — an exactly zero amount keeps '(≈ €0.00)'."
  },

